# Copy to .env.local for local development. These NEXT_PUBLIC values are NOT secret
# (they identify your Firebase project; security comes from Firestore rules).
# They are inlined at build time, so they must also exist in your Cloudflare build settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
