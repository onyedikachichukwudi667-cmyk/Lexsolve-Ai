rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Admins are created by hand in the Firebase console: admins/{uid} with any field.
    // Nobody can write this collection from the app.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'lastSeen']);
      allow delete: if false;

      // answers, authorities, library, chunks, saved: private to the owner only.
      match /{sub}/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
